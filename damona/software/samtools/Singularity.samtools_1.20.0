Bootstrap: docker
From: alpine:3.20

%labels
    Author Thomas Cokelaer, Claude
    Version 1.20.0
    Description samtools 1.20 (reports "samtools 1.20"); built from the release tarball on alpine 3.20

%post
    set -e
    # runtime libraries (kept) + bash
    apk add --no-cache bash ncurses-libs zlib libbz2 xz-libs libgcc libcurl libdeflate ca-certificates

    # build-only dependencies (removed afterwards)
    apk add --no-cache --virtual=.build-deps curl curl-dev ncurses-dev musl-dev g++ make \
        zlib-dev xz-dev bzip2-dev libdeflate-dev

    mkdir -p /opt/src
    cd /opt/src
    curl -fsSL -O https://github.com/samtools/samtools/releases/download/1.20/samtools-1.20.tar.bz2
    echo "c71be865e241613c2ca99679c074f1a0daeb55288af577db945bdabe3eb2cf10  samtools-1.20.tar.bz2" | sha256sum -c -
    tar xjf samtools-1.20.tar.bz2
    cd samtools-1.20
    ./configure --prefix=/usr/local
    make -j2
    make install

    cd /
    rm -rf /opt/src
    apk del .build-deps
    rm -rf /var/cache/apk/*

%environment
    export LANG=C.UTF-8

%runscript
    exec samtools "$@"

%test
    set -e
    samtools --version | head -1 | grep -qx "samtools 1.20"
    printf '@SQ\tSN:c\tLN:10\nr1\t0\tc\t1\t60\t4M\t*\t0\t0\tACGT\tIIII\n' | samtools view -b - | samtools flagstat - | grep -q "1 + 0 in total"
    test -x /bin/bash
