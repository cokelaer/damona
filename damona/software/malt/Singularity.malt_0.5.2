Bootstrap: docker
From: debian:bookworm-slim

# Strategy: BUILD FROM SOURCE with plain javac (no ant, no module system).
# Source tree inspected: husonlab/malt v0.5.2 (Jan 2021) imports jloda.* and megan.* from sibling checkouts
# (antbuild/build.xml hard-codes ../../jloda, ../../megan-ce and a local JavaFX dir). All three repos were
# last committed on 28 Jan 2021 16:0x, so the sibling pins below are the last commits <= the malt tag date.
# jloda/megan-ce publish no tag for that date -> pinned by commit SHA. The three source trees are merged
# into one flat tree (module-info.java dropped) and MaltBuild/MaltRun are compiled against the repos' jars/.

%labels
  Author Thomas Cokelaer, Claude
  Version 0.5.2
  Description MALT - MEGAN alignment tool (fast alignment of metagenomic reads for MEGAN), built from source
  package.name malt
  package.version 0.5.2
  package.homepage https://github.com/husonlab/malt
  package.source.url https://github.com/husonlab/malt/archive/refs/tags/v0.5.2.tar.gz
  package.license GPL-3.0

%post
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  # runtime packages first (stay): JRE + openjfx. jloda.util.ProgramProperties touches javafx.scene.text.Font,
  # so the JavaFX jars AND natives are needed at runtime even headless. Then build-only packages (purged).
  apt-get install -y --no-install-recommends openjdk-17-jre-headless=17.0.20.1+1-1~deb12u1 \
      openjfx=11.0.11+1-3
  apt-get install -y --no-install-recommends openjdk-17-jdk-headless=17.0.20.1+1-1~deb12u1 \
      git ca-certificates

  mkdir -p /opt/src && cd /opt/src
  # tag v0.5.2 = 6f200c7ee78fb8553157819abcdf5caf22b59b3a
  git clone -q --depth 1 --branch v0.5.2 https://github.com/husonlab/malt.git malt
  # sibling repos: last commit dated 28 Jan 2021 (same minute window as the malt tag), pinned by SHA
  git clone -q https://github.com/husonlab/jloda.git jloda
  git -C jloda checkout -q a077b9e43e6e584fa22ee2760f47acda0537af4c
  git clone -q https://github.com/husonlab/megan-ce.git megan-ce
  git -C megan-ce checkout -q 148dedaff26f1b607599284209775f1ddcd9b961
  test "$(git -C malt rev-parse HEAD)" = 6f200c7ee78fb8553157819abcdf5caf22b59b3a

  mkdir -p flat classes
  for d in jloda/src megan-ce/src malt/src; do cp -r $d/. flat/; done
  rm -f flat/module-info.java
  CP="$(ls megan-ce/jars/*.jar jloda/jars/*.jar | tr '\n' ':')$(ls /usr/share/openjfx/lib/*.jar | tr '\n' ':')"
  find malt/src -name '*.java' ! -name module-info.java | sed 's|^malt/src|flat|' > srcs.txt
  javac -nowarn -encoding UTF-8 -proc:none -cp "$CP" -sourcepath flat -d classes @srcs.txt
  cp -r flat/. classes/
  find classes -name '*.java' -delete

  mkdir -p /opt/malt/lib
  jar cf /opt/malt/malt.jar -C classes .
  cp megan-ce/jars/*.jar jloda/jars/*.jar /opt/malt/lib/

  for t in build:MaltBuild run:MaltRun; do
    n=${t%%:*}; c=${t##*:}
    cat > /usr/local/bin/malt-$n <<WRAP
#!/bin/bash
# JVM flags here (not JAVA_TOOL_OPTIONS) to avoid stderr noise; prism.order=sw avoids libGL/MESA errors; works with read-only/absent HOME.
export XDG_CACHE_HOME=\${XDG_CACHE_HOME:-/tmp}   # fontconfig cache (read-only HOME safe)
exec java -Dprism.order=sw -Djava.util.prefs.userRoot=/tmp -Djava.util.prefs.systemRoot=/tmp -Duser.home=/tmp \\
     -Djava.awt.headless=true \${MALT_JAVA_OPTS:-} -cp "/opt/malt/malt.jar:/opt/malt/lib/*:/usr/share/openjfx/lib/*" malt.$c "\$@"
WRAP
    chmod 755 /usr/local/bin/malt-$n
  done

  apt-get purge -y openjdk-17-jdk-headless git ca-certificates
  apt-get autoremove -y --purge
  # purge/autoremove can drop the JRE (java alternative); make sure it is back (and openjfx)
  apt-get install -y --no-install-recommends openjdk-17-jre-headless=17.0.20.1+1-1~deb12u1
  apt-get install -y --no-install-recommends openjfx=11.0.11+1-3
  command -v java
  apt-get clean
  rm -rf /var/lib/apt/lists/* /opt/src /root/.java

%environment
  export LC_ALL=C

%test
  set -e
  test -x /bin/bash
  timeout 120 malt-run --help 2>&1 | grep -q "version 0\.5\.2"
  timeout 120 malt-build --help 2>&1 | grep -q "version 0\.5\.2"
