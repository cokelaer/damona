Bootstrap: docker
From: debian:bookworm-slim

%labels
    Author thomas cokelaer
    Version 1.3.0
    Software salmon
    Software2 gffread
    Source https://github.com/COMBINE-lab/salmon
    Source2 https://github.com/gpertea/gffread
    DAMONA_TYPE exe
    DAMONA_BIN salmon,gffread

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install temporary build dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

    # Install shared library required by salmon at runtime
    apt-get update && apt-get install -y --no-install-recommends \
        libtbb2 \
    && rm -rf /var/lib/apt/lists/*

    # Download and install salmon 1.3.0 precompiled binary
    wget -q https://github.com/COMBINE-lab/salmon/releases/download/v1.3.0/salmon-1.3.0_linux_x86_64.tar.gz \
        -O /tmp/salmon.tar.gz
    tar -xzf /tmp/salmon.tar.gz -C /tmp/
    cp -r /tmp/salmon-latest_linux_x86_64/bin/* /usr/local/bin/
    cp -r /tmp/salmon-latest_linux_x86_64/lib/* /usr/local/lib/
    rm -rf /tmp/salmon.tar.gz /tmp/salmon-latest_linux_x86_64

    # Download and install gffread 0.12.9 precompiled binary
    wget -q https://github.com/gpertea/gffread/releases/download/v0.12.9/gffread-0.12.9.Linux_x86_64.tar.gz \
        -O /tmp/gffread.tar.gz
    tar -xzf /tmp/gffread.tar.gz -C /tmp/
    cp /tmp/gffread-0.12.9.Linux_x86_64/gffread /usr/local/bin/gffread
    chmod +x /usr/local/bin/gffread
    rm -rf /tmp/gffread.tar.gz /tmp/gffread-0.12.9.Linux_x86_64

    # Purge build-only dependencies
    apt-get purge -y wget
    apt-get autoremove -y

    # Final cleanup
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Refresh shared library cache
    ldconfig

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

%runscript
    exec salmon "$@"
