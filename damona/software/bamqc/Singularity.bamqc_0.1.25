BootStrap: docker
From: ubuntu:24.04

%labels
  maintainer Thomas Cokelaer
  package.name bamqc
  package.version 0.1.25
  package.homepage https://github.com/s-andrews/BamQC
  package.source.url https://github.com/s-andrews/BamQC

%help
    BamQC 0.1.25 -- quality control for BAM files (Babraham Institute).

    Usage:
        singularity exec bamqc_0.1.25.img bamqc --version
        singularity exec bamqc_0.1.25.img bamqc -o outdir input.bam

    NOTE (version key): upstream publishes no tags and no releases, so the only
    version this software states about itself is the string hard-coded in its
    sources, "BamQC v0.1.25_devel". That is where the 0.1.25 key comes from.

%post
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  
  # Install Java runtime, perl, locales, and build dependencies
  apt-get install -y default-jre default-jdk-headless ant git perl locales

  # Configure locales to suppress Perl warnings
  echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
  locale-gen en_US.UTF-8
  update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

  # Clone, patch, and compile BamQC.
  # Pinned by commit because upstream publishes no tags or releases at all, so
  # there is no version to ask for. 4b3d20f is the repository HEAD and has been
  # since 2018-02-06; the binary self-reports "BamQC v0.1.25_devel", a string
  # hard-coded in the source rather than derived from any release.
  git clone https://github.com/s-andrews/BamQC.git /opt/BamQC
  cd /opt/BamQC
  git checkout -q 4b3d20f17b36
  sed -i 's/name="source" value="1.6"/name="source" value="1.8"/g' build.xml
  sed -i 's/name="target" value="1.6"/name="target" value="1.8"/g' build.xml
  ant
  
  # The bamqc script expects .class files in the root /uk/ directory
  # and explicitly crashes if it sees .java files (hardcoded anti-source check)
  cp -r bin/* .
  find . -name "*.java" -delete

  # Make executable and link it
  chmod 755 bamqc
  ln -s /opt/BamQC/bamqc /usr/local/bin/bamqc

  # Cleanup build packages to minimize footprint
  apt-get purge -y default-jdk-headless ant git
  apt-get autoremove -y
  apt-get clean
  rm -rf /var/lib/apt/lists/*

%environment
  export LANG=en_US.UTF-8
  export LC_ALL=en_US.UTF-8

%runscript
  exec bamqc "$@"

%test
  # apptainer does not run the testscript under -e: without this, a crashing
  # command is silently swallowed and the build still exits 0.
  set -e

  command -v bamqc > /dev/null || { echo "MISSING: bamqc"; exit 1; }

  # the registry key must match what the binary reports
  bamqc --version
  bamqc --version | grep -q "0\.1\.25"

  # the JRE must survive the apt-get purge above: only the JDK is removed, and
  # bamqc is a wrapper around java
  java -version 2>&1 | head -1
