Bootstrap: docker
From: alpine:3.15

%labels
    MAINTAINER thomas cokelaer
    Author thomas cokelaer
    Version v2.6

%files
    shustring-2.6.0.tar.gz

%post

    apk update\
        && apk upgrade\
        && apk add  make bash curl zlib-dev g++

    tar xvfz shustring-2.6.0.tar.gz

    mkdir /build
    mv Shustring_2.6  /build
    cd /build/Shustring_2.6

    # gcc10 defaults to -fno-common; Shallow_limit is a tentative definition
    # in both globals.c and shallow.c, which links fine as a common symbol
    # pre-gcc10 and fails with "multiple definition" since. Same fix as the
    # bwa build in the circlator recipe.
    sed -i 's/^CFLAGS=/CFLAGS= -fcommon /' Makefile DeepShallow/Makefile

    make
    cp shustring /usr/bin
    rm -rf /var/lib/apt/list/*

%runscript
    exec shustring "$@"


